# Safe local default. No external API calls are made in mock mode.
AI_PROVIDER=mock

# Required only when AI_PROVIDER=openai. Never expose these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_TIMEOUT_MS=15000
# A failed AI call returns explicitly labelled demo data. Set false for HTTP 502.
AI_FALLBACK_TO_MOCK=true

# Local MVP persistence. JSON files in /data are ignored by Git.
DATA_FILE_PATH=./data/db.json

# Variables prefixed with NEXT_PUBLIC_ are included in the browser bundle.
NEXT_PUBLIC_APP_NAME=AI Sana Tasks
